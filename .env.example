# ───────────────────────────────────────────────────────────────
# Academy Future Star — Environment Configuration
# ───────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it contains secrets.
# ───────────────────────────────────────────────────────────────

# Google Gemini API Key (required for AI features)
# Get yours from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Production website URL — used to generate QR codes on player CVs.
# Set this to the domain where your site is hosted.
# Example: https://wasfmila.com
VITE_APP_URL="https://your-website-domain.com"
